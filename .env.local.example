NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Sadece sunucu tarafinda kullanilir (kullanici davet etme). Tarayiciya asla gonderilmez,
# NEXT_PUBLIC_ ile baslamadigindan istemciye expose edilmez. Supabase Dashboard > Project Settings > API'den alin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Opsiyonel: atama bildirimleri icin Resend (resend.com) API anahtari.
# Tanimli degilse uygulama e-postasiz calisir, atamalar yine yapilir.
RESEND_API_KEY=
# Opsiyonel: gonderen adresi (Resend'de dogrulanmis domain gerekir)
EMAIL_FROM="BATSO Kampanya <kampanya@batso.app>"
